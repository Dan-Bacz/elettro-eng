generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  name      String
  email     String      @unique
  password  String?
  role      Role        @default(CLIENT)
  phone     String?
  approved  Boolean     @default(false)
  status    UserStatus  @default(ACTIVE)
  address   String?
  specialization String?
  yearsOfExperience Int?
  skills    String?
  profileImageUrl String?
  rejectionReason String?
  createdAt DateTime    @default(now())
  bookings  Booking[]
  reports   Report[]
  assignedBookings Booking[] @relation("AssignedBookings")
  technicianActivities TechnicianActivity[]
  notifications Notification[]
  materialRequests MaterialRequest[]
  projectAssignments ProjectAssignment[]
  leaveRequests LeaveRequest[] @relation("TechLeaves")
  leaveCredits LeaveCredits? @relation("TechLeaveCredits")
}

model Booking {
  id           String   @id @default(uuid())
  clientId     String
  client       User     @relation(fields: [clientId], references: [id])
  title        String
  description  String?
  status       BookingStatus @default(PENDING)
  assignedToId String?
  assignedTo   User?    @relation("AssignedBookings", fields: [assignedToId], references: [id])
  startDate    DateTime?
  endDate      DateTime?
  budget       Float?
  createdAt    DateTime @default(now())
  technicianActivities TechnicianActivity[]
  reports   Report[]
  materialRequests MaterialRequest[]
  project   Project?
}

// A project is created automatically when a booking is approved.
// Technicians are assigned to the project team; project status is driven by
// technician reporting once the team has been assigned.
model Project {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      BookingStatus @default(ASSIGNED)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  techId    String
  tech      User     @relation(fields: [techId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, techId])
}

model TechnicianActivity {
  id         String   @id @default(uuid())
  techId     String
  tech       User     @relation(fields: [techId], references: [id])
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  message    String
  createdAt  DateTime @default(now())
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  sku         String?  @unique
  category    String?
  brand       String?
  model       String?
  description String?
  quantity    Int      @default(0)
  unit        String?
  buyPrice    Float?
  sellPrice   Float?
  reorderLevel Int     @default(10)
  imageUrl    String?
  imagePublicId String?
  imageData   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  content   String
  progress  Int?
  workDone  String?
  issues    String?
  nextWork  String?
  photoUrls String?
  createdAt DateTime @default(now())
}

model MaterialRequest {
  id        String   @id @default(uuid())
  techId    String
  tech      User     @relation(fields: [techId], references: [id])
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  material  String
  quantity  Int      @default(1)
  unit      String?
  reason    String?
  priority  String   @default("NORMAL")
  status    String   @default("PENDING")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO")
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Leave management (based on CSC Form No. 6 - Application for Leave)
model LeaveRequest {
  id                String     @id @default(uuid())
  techId            String
  tech              User       @relation("TechLeaves", fields: [techId], references: [id], onDelete: Cascade)
  type              LeaveType
  fromDate          DateTime
  toDate            DateTime
  days              Int
  // CSC commutation: REQUESTED (with pay) or NOT_REQUESTED (without pay)
  commutation       String     @default("NOT_REQUESTED")
  // Vacation leave - address where the leave will be spent
  addressDuringLeave String?
  // Sick leave - medical certificate attached flag
  medicalCertificate Boolean   @default(false)
  reason            String?
  status            LeaveStatus @default(PENDING)
  adminNote         String?
  approvedDays      Int?
  decidedBy         String?
  decidedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([techId])
  @@index([status])
}

model LeaveCredits {
  id           String   @id @default(uuid())
  techId       String   @unique
  tech         User     @relation("TechLeaveCredits", fields: [techId], references: [id], onDelete: Cascade)
  vacation     Int      @default(15)
  sick         Int      @default(15)
  vacationUsed Int      @default(0)
  sickUsed     Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  TECH
  CLIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  APPROVED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  VACATION
  SICK
  MATERNITY
  PATERNITY
  SOLO_PARENT
  SPECIAL_PRIVILEGE
  STUDY
  VAWC
  REHABILITATION
  SPECIAL_EMERGENCY
  OTHER
}
