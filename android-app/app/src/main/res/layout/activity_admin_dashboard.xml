<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/el_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/el_surface"
        android:orientation="vertical">

        <!-- App bar: hamburger + title + bell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_appbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="10dp">

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/menu"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu"
                android:tint="@color/el_ink" />

            <TextView
                android:id="@+id/app_bar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:text="@string/app_bar_dashboard"
                android:textColor="@color/el_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/refresh"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh"
                android:tint="@color/el_ink" />

            <ImageButton
                android:id="@+id/btn_bell"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/notifications_toast"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notifications"
                android:tint="@color/el_ink" />
        </LinearLayout>

        <!-- Section title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/el_surface"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/section_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Content -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scroll_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="16dp">

                    <!-- ============ DASHBOARD (HOME) ============ -->
                    <LinearLayout
                        android:id="@+id/view_dashboard_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <!-- Welcome banner -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/welcome_admin_1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/welcome_admin_2"
                                    android:textColor="@color/brand_600"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/welcome_admin_3"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Stats grid (2 x 2) -->
                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:columnCount="2"
                            android:rowCount="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_card"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_icon_circle"
                                        android:contentDescription="Bookings"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_calendar"
                                        app:tint="@color/brand_600" />

                                    <TextView
                                        android:id="@+id/stat_total_bookings"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="0"
                                        android:textColor="@color/text_primary"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/stat_total_bookings"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="@string/trend_up"
                                    android:textColor="@color/status_active"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_card"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_icon_circle"
                                        android:contentDescription="Pending"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_clock"
                                        app:tint="@color/status_pending" />

                                    <TextView
                                        android:id="@+id/stat_pending"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="0"
                                        android:textColor="@color/status_pending"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/stat_pending_review"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="@string/trend_watch"
                                    android:textColor="@color/text_faint"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_card"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_icon_circle"
                                        android:contentDescription="Inventory"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_inventory"
                                        app:tint="@color/status_active" />

                                    <TextView
                                        android:id="@+id/stat_inventory"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="0"
                                        android:textColor="@color/text_primary"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/stat_total_inventory"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="@string/trend_items"
                                    android:textColor="@color/text_faint"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_card"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_icon_circle"
                                        android:contentDescription="Low stock"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_warning"
                                        app:tint="@color/status_rejected" />

                                    <TextView
                                        android:id="@+id/stat_low_stock"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="0"
                                        android:textColor="@color/status_rejected"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/stat_low_stock"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="@string/trend_warn"
                                    android:textColor="@color/text_faint"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </GridLayout>

                        <!-- Recent bookings -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/recent_bookings_title"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/btn_goto_bookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/view_all"
                                    android:textColor="@color/brand_600"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/recent_bookings_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <!-- Quick actions -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/quick_actions_title"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:columnCount="2"
                            android:rowCount="2">

                            <LinearLayout
                                android:id="@+id/btn_qa_add_client"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_card"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:contentDescription="@string/qa_add_client"
                                    android:src="@drawable/ic_person"
                                    app:tint="@color/brand_600" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/qa_add_client"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/btn_qa_new_booking"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_card"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:contentDescription="@string/qa_new_booking"
                                    android:src="@drawable/ic_bookings"
                                    app:tint="@color/brand_600" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/qa_new_booking"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/btn_qa_assign_tech"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginEnd="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_card"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:contentDescription="@string/qa_assign_tech"
                                    android:src="@drawable/ic_build"
                                    app:tint="@color/brand_600" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/qa_assign_tech"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/btn_qa_add_inventory"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_card"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:contentDescription="@string/qa_add_inventory"
                                    android:src="@drawable/ic_inventory"
                                    app:tint="@color/brand_600" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/qa_add_inventory"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </GridLayout>
                    </LinearLayout>

                    <!-- ============ BOOKINGS ============ -->
                    <LinearLayout
                        android:id="@+id/view_bookings_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp">

                                <Button
                                    android:id="@+id/filter_all"
                                    style="@style/Widget.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_selected"
                                    android:text="ALL"
                                    android:textColor="@color/el_ink" />

                                <Button
                                    android:id="@+id/filter_pending"
                                    style="@style/Widget.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="PENDING"
                                    android:textColor="@color/status_pending" />

                                <Button
                                    android:id="@+id/filter_approved"
                                    style="@style/Widget.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="APPROVED"
                                    android:textColor="@color/status_approved" />

                                <Button
                                    android:id="@+id/filter_assigned"
                                    style="@style/Widget.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="ASSIGNED"
                                    android:textColor="@color/status_in_progress" />

                                <Button
                                    android:id="@+id/filter_completed"
                                    style="@style/Widget.Chip"
                                    android:layout_width="wrap_content"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="COMPLETED"
                                    android:textColor="@color/status_completed" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <LinearLayout
                            android:id="@+id/bookings_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ============ PROJECTS ============ -->
                    <LinearLayout
                        android:id="@+id/view_projects_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/projects_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ============ NOTIFICATIONS ============ -->
                    <LinearLayout
                        android:id="@+id/view_notifications_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btn_mark_all_read"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_chip_unselected"
                            android:text="@string/mark_all_read"
                            android:textColor="@color/el_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/notifications_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ============ CLIENTS ============ -->
                    <LinearLayout
                        android:id="@+id/view_clients_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/clients_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ============ TECHNICIANS (incl. registrations) ============ -->
                    <LinearLayout
                        android:id="@+id/view_technicians_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/pending_registrations"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/more_reg_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/status_pending"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/registrations_list_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/drawer_technicians"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btn_add_technician"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:background="@drawable/bg_action_yellow"
                                    android:text="@string/add_tech_label"
                                    android:textColor="@color/el_ink"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/technicians_list_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ============ INVENTORY ============ -->
                    <LinearLayout
                        android:id="@+id/view_inventory_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/drawer_inventory"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btn_add_inventory"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_action_yellow"
                                android:text="@string/add_item_label"
                                android:textColor="@color/el_ink"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/inventory_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ============ REPORTS ============ -->
                    <LinearLayout
                        android:id="@+id/view_reports_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/reports_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ============ SETTINGS ============ -->
                    <LinearLayout
                        android:id="@+id/view_settings_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/settings_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Organization Name"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />

                            <EditText
                                android:id="@+id/settings_org_name"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_card"
                                android:paddingHorizontal="10dp"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Support Email"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp" />

                            <EditText
                                android:id="@+id/settings_support_email"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_card"
                                android:inputType="textEmailAddress"
                                android:paddingHorizontal="10dp"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/btn_save_settings"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_action_yellow"
                                android:text="Save Changes"
                                android:textColor="@color/el_ink"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Navigation drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawer_bg"
        app:headerLayout="@layout/drawer_header"
        app:itemBackground="@drawable/bg_drawer_item"
        app:itemIconTint="@color/drawer_item_tint"
        app:itemTextColor="@color/drawer_item_text"
        app:menu="@menu/drawer_admin" />
</androidx.drawerlayout.widget.DrawerLayout>