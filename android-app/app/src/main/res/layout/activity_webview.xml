<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:orientation="vertical">

    <View
        android:id="@+id/web_loading"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FFC300" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/web_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F7F8FA"
                android:overScrollMode="never" />

            <LinearLayout
                android:id="@+id/web_error_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F7F8FA"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elettro"
                    android:textColor="#0B0F10"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/web_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#64748B"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/web_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#FFC300"
                    android:text="Try again"
                    android:textColor="#0B0F10"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
