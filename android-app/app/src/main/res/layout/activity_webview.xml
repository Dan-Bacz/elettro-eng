<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/web_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:id="@+id/web_loading"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#FFC300" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/web_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/web_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F7F8FA"
                    android:overScrollMode="never" />

                <ImageButton
                    android:id="@+id/web_menu_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_header_icon_circle"
                    android:contentDescription="@string/open_navigation"
                    android:elevation="8dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_menu"
                    android:tint="@color/white"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/web_error_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F7F8FA"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elettro"
                        android:textColor="#0B0F10"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/web_error_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="#64748B"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/web_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="#FFC300"
                        android:text="Try again"
                        android:textColor="#0B0F10"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/web_tech_nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawer_bg"
        android:visibility="gone"
        app:headerLayout="@layout/drawer_header"
        app:itemBackground="@drawable/bg_drawer_item"
        app:itemIconTint="@color/drawer_item_tint"
        app:itemTextColor="@color/drawer_item_text"
        app:menu="@menu/drawer_tech" />
</androidx.drawerlayout.widget.DrawerLayout>
