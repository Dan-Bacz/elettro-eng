<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/el_surface">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_header_gradient">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bolt_yellow"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/app_name_full"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Technician"
            android:textColor="@color/brand_500"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_refresh"
            android:scaleType="centerInside"
            android:tint="@color/white"
            android:contentDescription="@string/refresh" />
    </LinearLayout>

    <!-- Section title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/el_surface">

        <TextView
            android:id="@+id/section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/section_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingBottom="16dp">

                <!-- HOME -->
                <LinearLayout
                    android:id="@+id/view_home_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Welcome / profile banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_header_gradient"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/tech_avatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:src="@drawable/ic_person"
                            android:contentDescription="Avatar" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tech_welcome"
                                android:textColor="@color/text_faint"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tech_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tech_spec"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/brand_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Stats row -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:layout_marginTop="8dp">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginEnd="3dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp">
                            <TextView android:id="@+id/stat_active_jobs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/status_in_progress" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tech_active_jobs" android:textColor="@color/text_muted" android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp">
                            <TextView android:id="@+id/stat_completed_jobs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/status_active" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tech_completed_jobs" android:textColor="@color/text_muted" android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginStart="3dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp">
                            <TextView android:id="@+id/stat_pending_materials" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/status_pending" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tech_pending_materials" android:textColor="@color/text_muted" android:textSize="10sp" />
                        </LinearLayout>
                    </GridLayout>

                    <!-- Quick actions -->
                    <Button
                        android:id="@+id/btn_quick_report"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_action_yellow"
                        android:text="@string/tech_quick_report"
                        android:textColor="@color/el_ink"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_quick_material"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_action_dark"
                        android:text="@string/tech_quick_material"
                        android:textColor="@color/brand_400"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <!-- Recently updated jobs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recent Jobs"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/tech_recent_jobs_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- MY JOBS -->
                <LinearLayout
                    android:id="@+id/view_jobs_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:paddingVertical="4dp">

                        <Button
                            android:id="@+id/tab_active"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:text="@string/tab_active"
                            android:textColor="@color/el_ink"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/tab_completed"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:text="@string/tab_completed"
                            android:textColor="@color/status_active"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/jobs_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- REPORTS -->
                <LinearLayout
                    android:id="@+id/view_reports_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_new_report"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_action_yellow"
                        android:text="@string/tech_submit_report"
                        android:textColor="@color/el_ink"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/reports_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- NOTIFICATIONS -->
                <LinearLayout
                    android:id="@+id/view_notifications_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_mark_all_read"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="@string/mark_all_read"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/el_ink" />

                    <LinearLayout
                        android:id="@+id/notifications_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- PROFILE -->
                <LinearLayout
                    android:id="@+id/view_profile_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_circle"
                            android:src="@drawable/ic_person"
                            android:contentDescription="Avatar" />

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/profile_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:id="@+id/profile_email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/phone_number" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/profile_phone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/specialization" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/profile_spec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/experience" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/profile_exp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Skills" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/profile_skills" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_logout"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_action_red"
                        android:text="@string/logout"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        app:menu="@menu/bottom_nav_tech"
        app:itemIconTint="@color/bottom_nav_item_tint"
        app:itemTextColor="@color/bottom_nav_item_tint"
        app:itemIconSize="22dp"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>