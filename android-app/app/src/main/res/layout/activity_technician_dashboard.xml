<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f4f4f4"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Technician Dashboard"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="P-001 • Electrical Installation • Juan Dela Cruz"
            android:background="#f5c400"
            android:padding="14dp"
            android:layout_marginTop="18dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="P-002 • Maintenance Service • ABC Company"
            android:background="#ffffff"
            android:padding="14dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress Report"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:textColor="#111111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Completed wiring inspection\n- Submitted material request\n- Awaiting client approval"
            android:background="#ffffff"
            android:padding="14dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Material Requests"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:textColor="#111111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PVC Conduit: 10 pcs\nElectrical Tape: 2 pcs\nCable Breaker: 5 pcs"
            android:background="#ffffff"
            android:padding="14dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
